{
  "name": "larp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-simulator.mjs && next build",
    "check": "bun run lint && bun run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "node scripts/build-simulator.mjs && next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "bun run build && bun run start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-simulator.mjs && vitest run",
    "db:seed": "bun scripts/seed.ts",
    "test:e2e": "playwright test",
    "simulator:build": "node scripts/build-simulator.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.9.17",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@daypicker/react": "^10.0.2",
    "@lezer/highlight": "^1.2.5",
    "@libsql/client": "^0.14.0",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "linkedom": "^0.18.13",
    "next": "^15.2.3",
    "pixelarticons": "^2.4.2",
    "postcss": "^8.5.30",
    "prism-react-renderer": "^2.4.1",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "eslint-plugin-drizzle": "^0.2.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.15",
    "typescript-eslint": "^8.27.0",
    "vitest": "^5.0.5"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "overrides": {
    "postcss": "^8.5.30",
    "esbuild": "^0.28.2"
  }
}
