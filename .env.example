# SQLite locally; use libsql:// with a token for hosted Turso/libSQL.
DATABASE_URL="file:./db.sqlite"
DATABASE_AUTH_TOKEN=""
# Vercel Storage → Turso creates TURSO_DATABASE_URL and TURSO_AUTH_TOKEN.
# LARP automatically uses that pair when present; no renaming is needed.

# Both Clerk keys are required for learning. Get them from your Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Optional signing key for migrating older guest progress after sign-in.
GUEST_SESSION_SECRET=""
# Public origin, especially when running behind a reverse proxy.
APP_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/auth/continue"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/auth/continue"

# Optional: leave blank to keep analytics disabled. Use your PostHog project region.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
