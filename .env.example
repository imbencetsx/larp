# SQLite locally; use libsql:// with a token for hosted Turso/libSQL.
DATABASE_URL="file:./db.sqlite"
DATABASE_AUTH_TOKEN=""

# Add both keys to enable Clerk. Without them, LARP uses a clearly labeled,
# database-backed guest session. Get keys from your Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"
