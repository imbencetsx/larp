# SQLite locally; use libsql:// with a token for hosted Turso/libSQL.
DATABASE_URL="file:./db.sqlite"
DATABASE_AUTH_TOKEN=""
# Vercel Storage → Turso creates TURSO_DATABASE_URL and TURSO_AUTH_TOKEN.
# LARP automatically uses that pair when present; no renaming is needed.

# Add both keys to enable Clerk. Without them, LARP uses a clearly labeled,
# database-backed guest session. Get keys from your Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Optional dedicated signing key (at least 32 random characters). Required in
# production guest-only mode; otherwise Clerk's server secret signs sessions.
GUEST_SESSION_SECRET=""
# Public origin, especially when running behind a reverse proxy.
APP_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"
